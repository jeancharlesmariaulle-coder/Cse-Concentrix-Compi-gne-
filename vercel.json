{
  "builds": [
    { "src": "cse.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "icon-*.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/cse", "dest": "/cse.js" },
    { "src": "/sw.js", "headers": { "Cache-Control": "no-cache", "Service-Worker-Allowed": "/" }, "dest": "/sw.js" },
    { "src": "/manifest.webmanifest", "headers": { "Content-Type": "application/manifest+json" }, "dest": "/manifest.webmanifest" },
    { "src": "/", "dest": "/index.html" }
  ]
}
